{{- $articles := slice -}}

{{- $allPages := where site.RegularPages "Section" "!=" "all-articles" -}}
{{- $allPages = where $allPages "Draft" false -}}
{{- $allPages = $allPages.ByDate.Reverse -}}

{{- range $allPages -}}
  {{- $title := .Title -}}
  {{- $readingTime := 0 -}}
  {{- if .Params.readingTime -}}
    {{- $readingTime = .Params.readingTime -}}
  {{- end -}}
  
  {{- $difficulty := "" -}}
  {{- if .Params.difficulty -}}
    {{- $difficulty = .Params.difficulty -}}
  {{- end -}}
  
  {{- $labRequired := false -}}
  {{- if .Params.lab_required -}}
    {{- $labRequired = .Params.lab_required -}}
  {{- end -}}
  
  {{- $postType := "" -}}
  {{- if .Params.post_type_fa -}}
    {{- $postType = .Params.post_type_fa -}}
  {{- end -}}
  
  {{- $featuredImage := "" -}}
  {{- if .Params.featured_image -}}
    {{- $featuredImage = .Params.featured_image | relURL -}}
  {{- else if .Params.images -}}
    {{- if reflect.IsSlice .Params.images -}}
      {{- $featuredImage = (index .Params.images 0) | relURL -}}
    {{- else -}}
      {{- $featuredImage = .Params.images | relURL -}}
    {{- end -}}
  {{- end -}}
  
  {{- $summary := "" -}}
  {{- if .Params.description -}}
    {{- $summary = .Params.description | plainify | truncate 600 -}}
  {{- else if .Summary -}}
    {{- $summary = .Summary | plainify | truncate 600 -}}
  {{- else -}}
    {{- $summary = .Content | plainify | truncate 600 -}}
  {{- end -}}
  
  {{- $tags := slice -}}
  {{- if .Params.tags -}}
    {{- $tags = .Params.tags -}}
  {{- end -}}
  
  {{- $categoryTitle := "" -}}
  {{- $categoryUrl := "" -}}
  {{- if .CurrentSection -}}
    {{- $categoryTitle = .CurrentSection.Title -}}
    {{- $categoryUrl = .CurrentSection.RelPermalink -}}
  {{- end -}}
  
  {{- $article := dict 
    "title" $title 
    "url" .RelPermalink 
    "readingTime" $readingTime 
    "difficulty" $difficulty 
    "labRequired" $labRequired 
    "postType" $postType 
    "featuredImage" $featuredImage 
    "summary" $summary 
    "tags" $tags
    "section" .Section
    "categoryTitle" $categoryTitle
    "categoryUrl" $categoryUrl
    "date" (.Date.Format "2006-01-02T15:04:05Z07:00")
    "dateUnix" .Date.Unix
  -}}
  
  {{- $articles = $articles | append $article -}}
{{- end -}}
{{- $articles | jsonify -}}
